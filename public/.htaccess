# Apache config for the Virtualmin vhost. Lives in public/ so Vite copies it
# into dist/ and the deploy ships it with the build — the server keeps no
# hand-maintained config of its own.

Options -Indexes

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ACME/Let's Encrypt validation must never be rewritten.
  RewriteRule ^\.well-known/ - [L]

  # Real files and directories are served as-is (assets, icons, sw.js, manifest).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: serve the app shell. Without this,
  # a deep link or a reload on a non-root URL 404s before the SW can answer.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite emits content-hashed asset filenames (name-<hash>.js), so those URLs
  # never change meaning.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Icons keep stable names across builds, so only a short cache.
  <FilesMatch "\.(png|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Entry points must be revalidated on every load, otherwise a client keeps
  # booting an old build forever. Listed last so it wins over the rules above.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
