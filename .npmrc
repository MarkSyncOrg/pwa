@marksyncorg:registry=https://npm.pkg.github.com

# No token here. pnpm ignores credentials that come from a project .npmrc — the file
# is committed, so an expanded ${NODE_AUTH_TOKEN} could be leaked to whatever registry
# the file happens to name. The line that used to sit here was silently inert.
#
# CI gets its token from actions/setup-node, which writes a user-level ~/.npmrc.
# Locally, put it in your own ~/.npmrc or run:
#
#   pnpm config set '//npm.pkg.github.com/:_authToken' <token with read:packages>
