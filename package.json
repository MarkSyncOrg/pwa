{
  "name": "marksync-pwa",
  "version": "0.1.0",
  "description": "MarkSync standalone bookmark PWA (xBrowserSync-compatible). Consumes @marksyncorg/core for crypto/api/sync; manages its own bookmark store (no browser.bookmarks).",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@marksyncorg/core": "0.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0"
  }
}
